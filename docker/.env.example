# Локально: cp .env.example .env  (значения по умолчанию подходят для разработки)
# Сервер:   содержимое этого файла с боевыми значениями кладётся в GitLab CI/CD-переменную
#           CUCUMBERBOT_ENV (тип File) — см. deploy/README.md

# --- Секреты (на сервере обязательны, сгенерировать: openssl rand -hex 32) ---
DB_PASSWORD=postgres
JWT_SECRET=change-me-in-production-use-32-chars-minimum
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Администратор создаётся при первом запуске (миграция 001). Пароль сменить после входа.
ADMIN_EMAIL=admin@cucumberbot.io
ADMIN_PASSWORD=Admin1234!

# --- Робот ---
# Адрес rosbridge_server на роботе (ROS 2). Должен быть доступен с сервера (VPN/проброс порта).
ROSBRIDGE_URL=ws://rosbridge:9090
# Топики ROS 2: одометрия и поза в кадре map (Nav2 AMCL)
ROS_ODOM_TOPIC=/odom
ROS_POSE_TOPIC=/amcl_pose
# Имитация телеметрии, пока робот не подключён (на сервере — false)
ROS_SIMULATION=true

# --- Веб ---
# Домены фронтенда через запятую (CORS); "*" — только для разработки
CORS_ORIGINS=*
# Включает /api/docs — на сервере всегда false
DEBUG=false
# Локальный порт фронтенда (на сервере не используется — работает Caddy)
HTTP_PORT=80
# Консоль MinIO на сервере: 127.0.0.1:<порт>, доступ через ssh-туннель
MINIO_CONSOLE_PORT=19001
